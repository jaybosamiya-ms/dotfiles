#!/usr/bin/bash
set -eu
PROG="${0##*/}"

# ---------------------------------------------------------------------------
# Dangerous-directory guard
# ---------------------------------------------------------------------------
REAL_PWD=$(realpath "$PWD")
if [[ -z "$HOME" ]]; then
    echo "$PROG: HOME is unset or empty" >&2
    exit 1
fi
REAL_HOME="$HOME"

if [[ "$REAL_PWD" == "/" || "$REAL_PWD" == "/home" || "$REAL_PWD" == "$REAL_HOME" ]]; then
    echo "$PROG: refusing to run from $REAL_PWD (use a project subdirectory)" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Resolve claude binary once at script time
# ---------------------------------------------------------------------------
CLAUDE_BIND_ARGS=()
if [[ -e "$REAL_HOME/.local/bin/claude" ]]; then
    CLAUDE_REAL=$(readlink -f "$REAL_HOME/.local/bin/claude")
    CLAUDE_BIND_ARGS=(--ro-bind "$CLAUDE_REAL" "$CLAUDE_REAL")
fi

# ---------------------------------------------------------------------------
# Ensure pi has an existing persistent writable config/session directory
# ---------------------------------------------------------------------------
PI_BIND_ARGS=()
if [[ -d "$REAL_HOME/.pi" ]]; then
    PI_BIND_ARGS=(--bind "$REAL_HOME/.pi" /home/sandbox/.pi)
fi

# ---------------------------------------------------------------------------
# Open .claude.json on fd 3 before we enter the sandbox
# ---------------------------------------------------------------------------
CLAUDE_CONFIG_ARGS=()
if [[ -f "$REAL_HOME/.claude.json" ]]; then
    exec 3<"$REAL_HOME/.claude.json"
    CLAUDE_CONFIG_ARGS=(--file 3 /home/sandbox/.claude.json)
fi

# ---------------------------------------------------------------------------
# Synthetic /etc/passwd and /etc/group for the sandbox user
# ---------------------------------------------------------------------------
REAL_UID=$(id -u)
REAL_GID=$(id -g)
exec 4< <(printf 'sandbox:x:%s:%s::/home/sandbox:/bin/zsh\n' "$REAL_UID" "$REAL_GID")
exec 5< <(printf 'sandbox:x:%s:\n' "$REAL_GID")

# ---------------------------------------------------------------------------
# Derive host username for p10k cache paths
# ---------------------------------------------------------------------------
HOST_USER="${USER:-$(id -un)}"

NODE_VERSION="24.17.0"

# ---------------------------------------------------------------------------
# Project-keyed host cache for Cargo build artifacts
# ---------------------------------------------------------------------------
EPHEMERAL_CACHE=false
EPHEMERAL_TMP=false
HELP_REQUESTED=false
for arg in "$@"; do
    case "$arg" in
        --ephemeral-cache) EPHEMERAL_CACHE=true ;;
        --ephemeral-tmp) EPHEMERAL_TMP=true ;;
        -h|--help) HELP_REQUESTED=true; break ;;
        shell|claude|pi|opencode|--run) break ;;
    esac
done

TMP_MOUNT_ARGS=(--tmpfs /tmp)
CARGO_CACHE_MOUNT_ARGS=()
if { ! $EPHEMERAL_CACHE || ! $EPHEMERAL_TMP; } && ! $HELP_REQUESTED; then
    CACHE_PARENT=${TMPDIR:-/tmp}
    CACHE_ROOT="$CACHE_PARENT/bw-cache-$REAL_UID"
    if ! mkdir -m 700 "$CACHE_ROOT" 2>/dev/null; then
        if [[ ! -d "$CACHE_ROOT" || -L "$CACHE_ROOT" || $(stat -c %u "$CACHE_ROOT") != "$REAL_UID" ]]; then
            echo "$PROG: unsafe cache directory: $CACHE_ROOT" >&2
            exit 1
        fi
        chmod 700 "$CACHE_ROOT"
    fi
    PROJECT_HASH=$(printf '%s' "$REAL_PWD" | sha256sum)
    PROJECT_HASH=${PROJECT_HASH%% *}
    PROJECT_CACHE="$CACHE_ROOT/$PROJECT_HASH"
    mkdir -p "$PROJECT_CACHE/tmp/cargo-target" "$PROJECT_CACHE/tmp/cargo-build" \
        "$PROJECT_CACHE/cargo-target" "$PROJECT_CACHE/cargo-build"

    if ! $EPHEMERAL_TMP; then
        TMP_MOUNT_ARGS=(--bind "$PROJECT_CACHE/tmp" /tmp)
    fi
    if ! $EPHEMERAL_CACHE; then
        CARGO_CACHE_MOUNT_ARGS=(
            --bind "$PROJECT_CACHE/cargo-target" /tmp/cargo-target
            --bind "$PROJECT_CACHE/cargo-build"  /tmp/cargo-build
        )
    elif ! $EPHEMERAL_TMP; then
        CARGO_CACHE_MOUNT_ARGS=(
            --tmpfs /tmp/cargo-target
            --tmpfs /tmp/cargo-build
        )
    fi
fi

# ---------------------------------------------------------------------------
# Preserve active mise tool PATH entries from the host shell.
# ---------------------------------------------------------------------------
MISE_PATH_PREFIX=""
IFS=: read -r -a HOST_PATH_ENTRIES <<< "${PATH:-}"
for entry in "${HOST_PATH_ENTRIES[@]}"; do
    if [[ "$entry" == "$REAL_HOME/.local/share/mise/"* && -d "$entry" ]]; then
        sandbox_entry="/home/sandbox${entry#"$REAL_HOME"}"
        case ":$MISE_PATH_PREFIX" in
            *":$sandbox_entry:"*) ;;
            *) MISE_PATH_PREFIX+="$sandbox_entry:" ;;
        esac
    fi
done
SANDBOX_BASE_PATH="/home/sandbox/.local/bin:/home/sandbox/.nix-profile/bin:/home/sandbox/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
SANDBOX_PATH="${MISE_PATH_PREFIX}/home/sandbox/.local/bin:/home/sandbox/.nix-profile/bin:/home/sandbox/.cargo/bin:/home/sandbox/.local/share/mise/installs/node/${NODE_VERSION}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ---------------------------------------------------------------------------
# Build bwrap argument array
# ---------------------------------------------------------------------------
BWRAP_ARGS=(

    # --- basic namespaces & lifecycle ---
    --hostname bubblewrap --unshare-uts
    --unshare-ipc
    --unshare-pid
    --unshare-user
    --disable-userns
    --die-with-parent

    # --- synthetic filesystems ---
    "${TMP_MOUNT_ARGS[@]}"
    "${CARGO_CACHE_MOUNT_ARGS[@]}"
    --dev   /dev
    --dir   /dev/net
    --dev-bind-try /dev/net/tun         /dev/net/tun  # For LiteBox
    --proc  /proc

    # --- read-only system directories ---
    --ro-bind /bin                      /bin
    --ro-bind /lib                      /lib
    --ro-bind-try /lib32                /lib32
    --ro-bind /lib64                    /lib64
    --ro-bind /usr/bin                  /usr/bin
    --ro-bind /usr/lib                  /usr/lib
    --ro-bind-try /usr/sbin             /usr/sbin
    --ro-bind-try /sbin                 /sbin
    --ro-bind-try /usr/local/bin        /usr/local/bin
    --ro-bind-try /usr/local/lib        /usr/local/lib
    --ro-bind-try /usr/libexec          /usr/libexec
    --ro-bind-try /usr/include          /usr/include
    --ro-bind-try /sys                  /sys

    # --- /etc fragments ---
    --ro-bind-try /etc/alternatives     /etc/alternatives
    --ro-bind    /etc/resolv.conf       /etc/resolv.conf
    --ro-bind-try /etc/profile.d        /etc/profile.d
    --ro-bind-try /etc/bash_completion.d /etc/bash_completion.d
    --ro-bind-try /etc/ssl/certs       /etc/ssl/certs
    --ro-bind-try /etc/ssl/openssl.cnf /etc/ssl/openssl.cnf
    --ro-bind-try /etc/ld.so.cache     /etc/ld.so.cache
    --ro-bind-try /etc/ld.so.conf      /etc/ld.so.conf
    --ro-bind-try /etc/ld.so.conf.d    /etc/ld.so.conf.d
    --ro-bind-try /etc/localtime       /etc/localtime
    --ro-bind-try /etc/nsswitch.conf   /etc/nsswitch.conf
    --ro-bind-try /etc/hosts           /etc/hosts
    --file 4                            /etc/passwd
    --file 5                            /etc/group
    --ro-bind-try /etc/zsh              /etc/zsh
    --ro-bind-try /etc/os-release       /etc/os-release
    --ro-bind-try /etc/apt              /etc/apt

    # --- /usr/share fragments ---
    --ro-bind-try /usr/share/terminfo   /usr/share/terminfo
    --ro-bind-try /usr/share/ca-certificates /usr/share/ca-certificates
    --ro-bind-try /usr/share/zoneinfo   /usr/share/zoneinfo
    --ro-bind-try /usr/share/zsh         /usr/share/zsh
    --ro-bind-try /usr/share/zsh-autosuggestions /usr/share/zsh-autosuggestions
    --ro-bind-try /usr/share/rr          /usr/share/rr

    # --- man / groff ---
    --ro-bind-try /etc/manpath.config   /etc/manpath.config
    --ro-bind-try /etc/groff            /etc/groff
    --ro-bind-try /usr/share/groff      /usr/share/groff
    --ro-bind-try /usr/share/man        /usr/share/man
    --ro-bind-try /usr/local/man        /usr/local/man
    --ro-bind-try /usr/share/doc        /usr/share/doc
    --ro-bind-try /usr/local/share/doc  /usr/local/share/doc
    --ro-bind-try /opt/man              /opt/man

    # --- synthetic home skeleton ---
    --dir /home
    --dir /home/sandbox
    --dir /home/sandbox/.cargo
    --dir /home/sandbox/.cargo/bin
    --dir /home/sandbox/.local
    --dir /home/sandbox/.local/bin
    --dir /home/sandbox/.local/share
    --dir /home/sandbox/.local/state
    --dir /home/sandbox/.claude
    --dir /home/sandbox/.pi
    --dir /home/sandbox/.config

    # --- dotfiles (ro, symlink targets) ---
    --ro-bind-try "$REAL_HOME/.dotfiles"    /home/sandbox/.dotfiles

    # --- shell configs (ro, into synthetic home) ---
    --ro-bind-try "$REAL_HOME/.bashrc"      /home/sandbox/.bashrc
    --ro-bind-try "$REAL_HOME/.zshrc"       /home/sandbox/.zshrc
    --ro-bind-try "$REAL_HOME/.zprofile"    /home/sandbox/.zprofile
    --ro-bind-try "$REAL_HOME/.profile"     /home/sandbox/.profile
    --ro-bind-try "$REAL_HOME/.oh-my-zsh"   /home/sandbox/.oh-my-zsh
    --ro-bind-try "$REAL_HOME/.p10k.zsh"    /home/sandbox/.p10k.zsh

    # --- rustup toolchains (ro) ---
    --ro-bind-try "$REAL_HOME/.rustup"            /home/sandbox/.rustup

    # --- lean toolchain (ro) ---
    --ro-bind-try "$REAL_HOME/.elan"              /home/sandbox/.elan

    # --- cargo: base ro, mutable cache/index dirs rw ---
    --ro-bind-try "$REAL_HOME/.cargo/env"          /home/sandbox/.cargo/env
    --ro-bind-try "$REAL_HOME/.cargo/bin"          /home/sandbox/.cargo/bin
    --ro-bind-try "$REAL_HOME/.cargo/config.toml"  /home/sandbox/.cargo/config.toml
    --bind-try    "$REAL_HOME/.cargo/registry"     /home/sandbox/.cargo/registry
    --bind-try    "$REAL_HOME/.cargo/git"          /home/sandbox/.cargo/git
    --tmpfs                                        /home/sandbox/.rustup/tmp

    # --- mise (ro) ---
    --ro-bind-try "$REAL_HOME/.local/share/mise" /home/sandbox/.local/share/mise
    # Some mise-installed tools contain absolute symlinks back to the host
    # mise tree. Keep that target available read-only too.
    --ro-bind-try "$REAL_HOME/.local/share/mise" "$REAL_HOME/.local/share/mise"
    --ro-bind-try "$REAL_HOME/.config/mise"      /home/sandbox/.config/mise

    # --- pi extensions (rw) ---
    --bind-try    "$REAL_HOME/.config/pi-extensions" /home/sandbox/.config/pi-extensions

    # --- jj config (ro) ---
    --ro-bind-try "$REAL_HOME/.config/jj" /home/sandbox/.config/jj

    # --- .local/bin (ro) — mise, env, etc; claude bound over it below ---
    --ro-bind-try "$REAL_HOME/.local/bin"     /home/sandbox/.local/bin

    # --- nix store + profile (ro) — needed for various nix-installed tools ---
    --ro-bind-try /nix/store                  /nix/store
    --ro-bind-try "$REAL_HOME/.nix-profile"   /home/sandbox/.nix-profile

    # --- Verus install (ro) — ~/.local/bin/{cargo-verus,verus} symlink here ---
    --ro-bind-try "$REAL_HOME/projects/verus/verus/main/source/target-verus/release" /home/jayb/projects/verus/verus/main/source/target-verus/release

    # --- misc dotfiles (ro) ---
    --ro-bind-try "$REAL_HOME/.gitconfig"     /home/sandbox/.gitconfig

    # --- claude symlink target (ro) — .local/bin/claude symlink points to real host path ---
    "${CLAUDE_BIND_ARGS[@]}"

    # --- .claude data dir (rw) ---
    --bind-try "$REAL_HOME/.claude"       /home/sandbox/.claude

    # --- pi config, auth, and session state (rw) ---
    "${PI_BIND_ARGS[@]}"

    # --- .claude.json via fd ---
    "${CLAUDE_CONFIG_ARGS[@]}"

    # --- .cache: only claude rw; p10k ro ---
    --dir /home/sandbox/.cache
    --bind-try "$REAL_HOME/.cache/claude"                              /home/sandbox/.cache/claude
    --ro-bind-try "$REAL_HOME/.cache/p10k-dump-${HOST_USER}.zsh"               /home/sandbox/.cache/p10k-dump-${HOST_USER}.zsh
    --ro-bind-try "$REAL_HOME/.cache/p10k-dump-${HOST_USER}.zsh.zwc"           /home/sandbox/.cache/p10k-dump-${HOST_USER}.zsh.zwc
    --ro-bind-try "$REAL_HOME/.cache/p10k-instant-prompt-${HOST_USER}.zsh"     /home/sandbox/.cache/p10k-instant-prompt-${HOST_USER}.zsh
    --ro-bind-try "$REAL_HOME/.cache/p10k-instant-prompt-${HOST_USER}.zsh.zwc" /home/sandbox/.cache/p10k-instant-prompt-${HOST_USER}.zsh.zwc
    --ro-bind-try "$REAL_HOME/.cache/p10k-${HOST_USER}"                        /home/sandbox/.cache/p10k-${HOST_USER}
    --ro-bind-try "$REAL_HOME/.cache/gitstatus"                        /home/sandbox/.cache/gitstatus

    --ro-bind-try "$REAL_HOME/.cache/dblp" /home/sandbox/.cache/dblp

    # --- clipboard image inbox (rw, intentionally the only host clipboard surface) ---
    --bind-try "$REAL_HOME/.cache/clipboardbox" /home/sandbox/.cache/clipboardbox

    # --- opencode state (rw) ---
    --bind-try "$REAL_HOME/.local/share/opencode" /home/sandbox/.local/share/opencode
    --bind-try "$REAL_HOME/.local/state/opencode" /home/sandbox/.local/state/opencode
    --bind-try "$REAL_HOME/.cache/opencode"       /home/sandbox/.cache/opencode
    --bind-try "$REAL_HOME/.config/opencode"      /home/sandbox/.config/opencode

    # --- project directory (rw, kept at real path) ---
    --bind "$REAL_PWD" "$REAL_PWD"
    --chdir "$REAL_PWD"

    # --- environment ---
    --clearenv
    --setenv HOME  /home/sandbox
    --setenv PATH  "$SANDBOX_PATH"
    --setenv __MISE_ORIG_PATH "$SANDBOX_BASE_PATH"
    --setenv TERM  "${TERM:-xterm-256color}"
    --setenv LANG  "${LANG:-en_US.UTF-8}"
    --setenv USER  "sandbox"
    # Trigger powerlevel10k prompt change
    --setenv SSH_CONNECTION "127.0.0.1 0 127.0.0.1 0"
    # Redirect Cargo artifacts into dedicated project caches unless made ephemeral.
    --setenv CARGO_TARGET_DIR      /tmp/cargo-target
    --setenv CARGO_BUILD_BUILD_DIR /tmp/cargo-build
    # TEMP FOR LITEBOX
    --setenv OUT_DIR /tmp
)

# ---------------------------------------------------------------------------
# Options that must precede SELECTION/--run
# ---------------------------------------------------------------------------
while [[ "${1:-}" == --ephemeral-cache || "${1:-}" == --ephemeral-tmp || "${1:-}" == --mount-readonly || "${1:-}" == --mount-readonly=* ]]; do
    if [[ "$1" == --ephemeral-cache || "$1" == --ephemeral-tmp ]]; then
        shift
        continue
    elif [[ "$1" == --mount-readonly=* ]]; then
        MOUNT_PATH=${1#--mount-readonly=}
        shift
    else
        if [[ $# -lt 2 ]]; then
            echo "$PROG: --mount-readonly requires a PATH argument" >&2
            exit 1
        fi
        MOUNT_PATH=$2
        shift 2
    fi
    if [[ ! -e "$MOUNT_PATH" ]]; then
        echo "$PROG: --mount-readonly: $MOUNT_PATH does not exist" >&2
        exit 1
    fi
    MOUNT_REAL=$(realpath "$MOUNT_PATH")
    BWRAP_ARGS+=(--ro-bind "$MOUNT_REAL" "$MOUNT_REAL")
done

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then
    cat >&2 <<EOF
Usage: $PROG [-h|--help] [--ephemeral-cache] [--ephemeral-tmp] [--mount-readonly PATH]... [SELECTION] [--run CMD [ARGS...]]

  SELECTION             One of: shell, claude, pi, opencode.
                        Launches that target directly (skips the fzf picker).
  --mount-readonly PATH Additionally bind PATH read-only at its real path
                        inside the sandbox. May be given multiple times.
                        Must come before SELECTION/--run.
  --ephemeral-cache     Keep Cargo build artifacts in tmpfs instead of their
                        dedicated project-keyed cache directories.
  --ephemeral-tmp       Keep general /tmp in tmpfs. Cargo remains cached unless
                        --ephemeral-cache is also given.
                        Both flags must come before SELECTION/--run.
  --run CMD [ARGS...]   Run CMD inside the sandbox (non-interactive).
                        With no arguments, launches an fzf picker.
EOF
    exit 0
fi

# --run: execute a command inside the sandbox via zsh -c, non-interactively
if [[ "${1:-}" == --run ]]; then
    shift
    exec /usr/bin/bwrap "${BWRAP_ARGS[@]}" /usr/bin/zsh -l -c "$*"
fi

case "${1:-}" in
    shell|claude|pi|opencode)
        CHOICE=$1
        ;;
    "")
        CHOICE=$(printf 'shell\nclaude\npi\nopencode\n' | fzf --prompt="$PROG> " --no-sort --reverse --height=8 --border) || exit 1
        ;;
    *)
        echo "$PROG: unknown argument: $1" >&2
        exit 1
        ;;
esac

case "$CHOICE" in
    shell)    exec /usr/bin/bwrap "${BWRAP_ARGS[@]}" /usr/bin/zsh -l ;;
    claude)   exec /usr/bin/bwrap "${BWRAP_ARGS[@]}" /usr/bin/zsh -l -c "/home/sandbox/.local/bin/claude --dangerously-skip-permissions" ;;
    pi)       exec /usr/bin/bwrap "${BWRAP_ARGS[@]}" /usr/bin/zsh -l -c "/home/sandbox/.local/share/mise/installs/node/${NODE_VERSION}/bin/pi" ;;
    opencode) exec /usr/bin/bwrap "${BWRAP_ARGS[@]}" /usr/bin/zsh -l -c "/home/sandbox/.local/share/mise/installs/node/${NODE_VERSION}/bin/opencode" ;;
esac
